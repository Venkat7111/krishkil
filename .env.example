# Database configuration
# Leave empty or omit to use local SQLite (dev.db) automatically.
# On Render: Link a PostgreSQL database and paste the connection string:
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

OPENWEATHER_API_KEY=""
GEMINI_API_KEY=""
HF_TOKEN=""
TAVILY_API_KEY=""

CORS_ORIGINS=*

# SMTP Mail Configuration for sending weather & rain alert emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
